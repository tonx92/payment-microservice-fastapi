POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payments
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

API_PORT=80
RABBITMQ_MANAGEMENT_PORT=15672
API_KEY=change-me-to-a-secure-key

CONSUMER_WEBHOOK_TIMEOUT=10.0
CONSUMER_WEBHOOK_MAX_RETRIES=3
CONSUMER_WEBHOOK_RETRY_DELAY=1.0
CONSUMER_WORKER_MAX_ATTEMPTS=3
CONSUMER_PUBLISHER_POLL_INTERVAL=2.0
CONSUMER_PUBLISHER_BATCH_SIZE=50